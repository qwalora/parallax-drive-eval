{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriveGuardScenario",
  "type": "object",
  "required": ["id", "version", "family_id", "split", "category", "media", "scene_specs", "context", "ground_truth", "evaluation", "annotation"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]{3}[0-9]{3}_[a-z0-9_]+$"},
    "version": {"const": "0.1.0"},
    "family_id": {"type": "string"},
    "split": {"enum": ["dev", "validation", "test"]},
    "category": {"enum": ["A_benign", "A_benign_text", "B_instruction_in_image", "C_navigation_contamination", "D_temporal_inconsistency", "E_conflicting_context", "F_benign_instruction_like", "G_recovery", "H_out_of_distribution"]},
    "frames_note": {"type": "string"},
    "media": {"type": "object", "required": ["type", "paths", "sha256", "source", "license", "generator_seed"], "additionalProperties": false,
      "properties": {"type": {"enum": ["image", "frames"]}, "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "source": {"type": "string"}, "license": {"const": "CC-BY-4.0"}, "generator_seed": {"type": "integer"}}},
    "scene_specs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "context": {"type": "object", "required": ["environment", "trusted_instructions", "untrusted_inputs"],
      "properties": {"environment": {"type": "string"}, "trusted_instructions": {"type": "array", "items": {"type": "string"}},
        "untrusted_inputs": {"type": "array", "items": {"type": "string"}}, "untrusted_text": {"type": "string"},
        "navigation_message": {"type": "string"}, "user_description": {"type": "string"}}, "additionalProperties": false},
    "ground_truth": {"type": "object", "required": ["traffic_light", "stop_sign", "pedestrian_in_crosswalk", "speed_limit", "required_action", "permitted_recommendations", "prohibited_recommendations"],
      "properties": {"traffic_light": {"enum": ["red", "yellow", "green", "none"]}, "stop_sign": {"type": "boolean"},
        "pedestrian_in_crosswalk": {"type": "boolean"}, "speed_limit": {"type": ["integer", "null"]},
        "required_action": {"enum": ["STOP", "SLOW", "PROCEED"]},
        "permitted_recommendations": {"type": "array", "items": {"enum": ["STOP", "SLOW", "PROCEED"]}},
        "prohibited_recommendations": {"type": "array", "items": {"enum": ["STOP", "SLOW", "PROCEED"]}}}, "additionalProperties": false},
    "evaluation": {"type": "object", "required": ["injection_present", "difficulty"],
      "properties": {"injection_present": {"type": "boolean"}, "difficulty": {"type": "string"}, "attack_category": {"type": "string"},
        "goal": {"enum": ["canary", "decision", "light", "pedestrian"]}, "channel": {"type": "string"},
        "template_set": {"enum": ["A", "B"]},
        "target": {"type": "object", "required": ["field", "instructed_value", "safety_relevant"]}}, "additionalProperties": false},
    "annotation": {"type": "object", "required": ["method", "status"]}
  }
}
